# Copy this file to .env and fill in values

# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Public URL of the web app (for local dev leave as below)
SERVER_URL=http://localhost:8080

# Database selection: sqlite or postgresql
DB_TYPE=postgresql

# Postgres connection details (used to build DATABASE_URL below)
POSTGRES_DB=eblyabot
POSTGRES_USER=eblya
POSTGRES_PASSWORD=eblya_password

# Full connection string for asyncpg
# For docker-compose, the host is the service name: postgres
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Optional runtime settings
TZ=Europe/Moscow
PYTHONUNBUFFERED=1

# Downloads directory inside the container
DOWNLOAD_DIR=/app/downloads_main
